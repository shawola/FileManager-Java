import javax.swing.*;
import javax.swing.filechooser.FileSystemView;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.awt.event.*;
import java.io.*;
import java.nio.file.*;
import java.util.*;
import java.util.List;

// استيراد مكتبات VLCJ للمشغل المدمج
import uk.co.caprica.vlcj.player.component.EmbeddedMediaPlayerComponent;

public class FileManager extends JFrame {

    private JTable table;
    private DefaultTableModel model;
    private JTextField pathField;
    private File currentDir;
    private JLabel statusBar;
    private JSplitPane splitPane;
    private JTextArea previewArea;
    private JLabel mediaPreview;

    private static final Set<String> VIDEO_EXT = new HashSet<>(Arrays.asList(
            "mp4", "mkv", "avi", "mov", "wmv", "flv", "webm", "m4v", "3gp", "mpg", "mpeg"
    ));

    private static final Set<String> IMAGE_EXT = new HashSet<>(Arrays.asList(
            "jpg", "jpeg", "png", "gif", "bmp", "webp"
    ));

    private static final Set<String> TEXT_EXT = new HashSet<>(Arrays.asList(
            "txt", "java", "xml", "json", "html", "css", "js", "md", "log", "csv", "ini", "properties"
    ));

    private static final Set<String> AUDIO_EXT = new HashSet<>(Arrays.asList(
            "mp3", "wav", "aac", "ogg", "flac", "m4a"
    ));

    public FileManager() {
        setTitle("مدير الملفات - مع مشغل فيديو مدمج");
        setSize(1100, 700);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout());

        // شريط الأدوات العلوي
        JPanel topPanel = new JPanel(new BorderLayout(5, 5));
        JButton backBtn = new JButton("⬅ رجوع");
        JButton homeBtn = new JButton("🏠 الرئيسية");
        JButton refreshBtn = new JButton("🔄 تحديث");
        JButton openBtn = new JButton("📂 فتح");
        pathField = new JTextField();
        pathField.setEditable(true);

        JPanel btnPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
        btnPanel.add(backBtn);
        btnPanel.add(homeBtn);
        btnPanel.add(refreshBtn);
        btnPanel.add(openBtn);

        topPanel.add(btnPanel, BorderLayout.WEST);
        topPanel.add(pathField, BorderLayout.CENTER);
        add(topPanel, BorderLayout.NORTH);

        // جدول الملفات
        model = new DefaultTableModel(new Object[]{"الاسم", "النوع", "الحجم", "المسار"}, 0) {
            public boolean isCellEditable(int r, int c) { return false; }
        };
        table = new JTable(model);
        table.setRowHeight(24);
        table.getColumnModel().getColumn(0).setPreferredWidth(250);
        table.getColumnModel().getColumn(1).setPreferredWidth(80);
        table.getColumnModel().getColumn(2).setPreferredWidth(100);
        table.getColumnModel().getColumn(3).setPreferredWidth(500);
        JScrollPane tableScroll = new JScrollPane(table);

        // لوحة المعاينة
        previewArea = new JTextArea();
        previewArea.setEditable(false);
        previewArea.setFont(new Font("Monospaced", Font.PLAIN, 13));
        JScrollPane previewScroll = new JScrollPane(previewArea);

        mediaPreview = new JLabel("لا توجد معاينة", SwingConstants.CENTER);
        mediaPreview.setOpaque(true);
        mediaPreview.setBackground(Color.DARK_GRAY);
        mediaPreview.setForeground(Color.WHITE);

        JTabbedPane previewTabs = new JTabbedPane();
        previewTabs.addTab("📝 نص", previewScroll);
        previewTabs.addTab("🖼 وسائط", mediaPreview);

        splitPane = new JSplitPane(JSplitPane.HORIZONTAL_SPLIT, tableScroll, previewTabs);
        splitPane.setDividerLocation(600);
        add(splitPane, BorderLayout.CENTER);

        // شريط الحالة
        statusBar = new JLabel(" جاهز ");
        statusBar.setBorder(BorderFactory.createEtchedBorder());
        add(statusBar, BorderLayout.SOUTH);

        // الأحداث
        backBtn.addActionListener(e -> goBack());
        homeBtn.addActionListener(e -> loadDirectory(FileSystemView.getFileSystemView().getHomeDirectory()));
        refreshBtn.addActionListener(e -> loadDirectory(currentDir));
        openBtn.addActionListener(e -> chooseDirectory());
        pathField.addActionListener(e -> {
            File f = new File(pathField.getText());
            if (f.exists()) loadDirectory(f);
        });

        // النقر على الجدول
        table.addMouseListener(new MouseAdapter() {
            public void mouseClicked(MouseEvent e) {
                if (e.getClickCount() == 2) {
                    int row = table.getSelectedRow();
                    if (row >= 0) {
                        String path = model.getValueAt(row, 3).toString();
                        File f = new File(path);
                        if (f.isDirectory()) loadDirectory(f);
                        else openFile(f);
                    }
                } else if (e.getClickCount() == 1) {
                    int row = table.getSelectedRow();
                    if (row >= 0) {
                        File f = new File(model.getValueAt(row, 3).toString());
                        showPreview(f);
                    }
                }
            }
        });

        // القائمة المنسدلة (زر يمين)
        JPopupMenu popup = new JPopupMenu();
        JMenuItem openItem = new JMenuItem("فتح / تشغيل");
        JMenuItem deleteItem = new JMenuItem("حذف");
        JMenuItem renameItem = new JMenuItem("إعادة تسمية");
        JMenuItem newFolderItem = new JMenuItem("مجلد جديد");
        popup.add(openItem);
        popup.add(renameItem);
        popup.add(deleteItem);
        popup.addSeparator();
        popup.add(newFolderItem);

        openItem.addActionListener(e -> openSelected());
        deleteItem.addActionListener(e -> deleteSelected());
        renameItem.addActionListener(e -> renameSelected());
        newFolderItem.addActionListener(e -> createFolder());

        table.setComponentPopupMenu(popup);

        loadDirectory(FileSystemView.getFileSystemView().getHomeDirectory());
    }

    private void loadDirectory(File dir) {
        if (dir == null || !dir.exists() || !dir.isDirectory()) return;
        currentDir = dir;
        pathField.setText(dir.getAbsolutePath());
        model.setRowCount(0);

        File[] files = dir.listFiles();
        if (files == null) return;

        Arrays.sort(files, (a, b) -> {
            if (a.isDirectory() && !b.isDirectory()) return -1;
            if (!a.isDirectory() && b.isDirectory()) return 1;
            return a.getName().compareToIgnoreCase(b.getName());
        });

        for (File f : files) {
            String type = f.isDirectory() ? "مجلد" : getExt(f.getName());
            String size = f.isDirectory() ? "" : humanSize(f.length());
            model.addRow(new Object[]{f.getName(), type, size, f.getAbsolutePath()});
        }

        statusBar.setText(" عدد العناصر: " + files.length + "  |  " + dir.getAbsolutePath());
    }

    private String getExt(String name) {
        int i = name.lastIndexOf('.');
        return (i > 0) ? name.substring(i + 1).toLowerCase() : "";
    }

    private String humanSize(long bytes) {
        if (bytes < 1024) return bytes + " B";
        double kb = bytes / 1024.0;
        if (kb < 1024) return String.format("%.2f KB", kb);
        double mb = kb / 1024.0;
        if (mb < 1024) return String.format("%.2f MB", mb);
        return String.format("%.2f GB", mb / 1024.0);
    }

    private void goBack() {
        if (currentDir != null && currentDir.getParentFile() != null) {
            loadDirectory(currentDir.getParentFile());
        }
    }

    private void chooseDirectory() {
        JFileChooser chooser = new JFileChooser(currentDir);
        chooser.setFileSelectionMode(JFileChooser.DIRECTORIES_ONLY);
        if (chooser.showOpenDialog(this) == JFileChooser.APPROVE_OPTION) {
            loadDirectory(chooser.getSelectedFile());
        }
    }

    private void openSelected() {
        int row = table.getSelectedRow();
        if (row < 0) return;
        File f = new File(model.getValueAt(row, 3).toString());
        if (f.isDirectory()) loadDirectory(f);
        else openFile(f);
    }

    private void openFile(File f) {
        String ext = getExt(f.getName());
        try {
            if (VIDEO_EXT.contains(ext)) {
                playVideoEmbedded(f); // تشغيل الفيديو عبر المشغل المدمج
            } else if (Desktop.isDesktopSupported()) {
                Desktop.getDesktop().open(f);
            }
        } catch (Exception ex) {
            JOptionPane.showMessageDialog(this, "تعذر فتح الملف: " + ex.getMessage());
        }
    }

    // دالة لتشغيل الفيديو داخل نافذة مدمجة باستخدام VLCJ
    private void playVideoEmbedded(File f) {
        JFrame videoFrame = new JFrame("مشغل الفيديو المدمج — " + f.getName());
        EmbeddedMediaPlayerComponent mediaPlayerComponent = new EmbeddedMediaPlayerComponent();

        videoFrame.setContentPane(mediaPlayerComponent);
        videoFrame.setSize(900, 550);
        videoFrame.setLocationRelativeTo(this);
        videoFrame.setVisible(true);

        // بدء تشغيل الفيديو
        mediaPlayerComponent.mediaPlayer().media().play(f.getAbsolutePath());

        // تنظيف الموارد عند إغلاق نافذة الفيديو لمنع تسريب الذاكرة
        videoFrame.addWindowListener(new WindowAdapter() {
            @Override
            public void windowClosing(WindowEvent e) {
                mediaPlayerComponent.release();
            }
        });
    }

    private void showPreview(File f) {
        if (f.isDirectory()) {
            previewArea.setText("📁 مجلد: " + f.getName() + "\n" + f.getAbsolutePath());
            mediaPreview.setIcon(null);
            mediaPreview.setText("مجلد");
            return;
        }
        String ext = getExt(f.getName());

        if (TEXT_EXT.contains(ext)) {
            try {
                String content = new String(Files.readAllBytes(f.toPath()));
                if (content.length() > 20000) content = content.substring(0, 20000) + "\n... (مقطوع)";
                previewArea.setText(content);
                previewArea.setCaretPosition(0);
            } catch (Exception ex) {
                previewArea.setText("تعذر قراءة الملف: " + ex.getMessage());
            }
            mediaPreview.setIcon(null);
            mediaPreview.setText("");
        } else if (IMAGE_EXT.contains(ext)) {
            try {
                ImageIcon icon = new ImageIcon(f.getAbsolutePath());
                Image img = icon.getImage().getScaledInstance(400, 400, Image.SCALE_SMOOTH);
                mediaPreview.setIcon(new ImageIcon(img));
                mediaPreview.setText("");
            } catch (Exception ex) {
                mediaPreview.setText("تعذر تحميل الصورة");
            }
            previewArea.setText("🖼 صورة: " + f.getName() + "\nالحجم: " + humanSize(f.length()));
        } else if (VIDEO_EXT.contains(ext)) {
            previewArea.setText("🎬 فيديو: " + f.getName() + "\nالحجم: " + humanSize(f.length())
                    + "\n\n(انقر نقراً مزدوجاً لفتح مشغل الفيديو المدمج)");
            mediaPreview.setIcon(null);
            mediaPreview.setText("🎬 فيديو — انقر مرتين للتشغيل");
        } else {
            previewArea.setText("نوع الملف: " + ext + "\nالحجم: " + humanSize(f.length())
                    + "\nالمسار: " + f.getAbsolutePath());
            mediaPreview.setIcon(null);
            mediaPreview.setText("لا معاينة لهذا النوع");
        }
    }

    private void deleteSelected() {
        int[] rows = table.getSelectedRows();
        if (rows.length == 0) return;
        int confirm = JOptionPane.showConfirmDialog(this, "حذف " + rows.length + " عنصر؟", "تأكيد", JOptionPane.YES_NO_OPTION);
        if (confirm != JOptionPane.YES_OPTION) return;
        for (int r : rows) {
            File f = new File(model.getValueAt(r, 3).toString());
            deleteRecursive(f);
        }
        loadDirectory(currentDir);
    }

    private void deleteRecursive(File f) {
        if (f.isDirectory()) {
            File[] children = f.listFiles();
            if (children != null) for (File c : children) deleteRecursive(c);
        }
        f.delete();
    }

    private void renameSelected() {
        int row = table.getSelectedRow();
        if (row < 0) return;
        File f = new File(model.getValueAt(row, 3).toString());
        String newName = JOptionPane.showInputDialog(this, "الاسم الجديد:", f.getName());
        if (newName != null && !newName.trim().isEmpty()) {
            File dest = new File(f.getParentFile(), newName);
            if (f.renameTo(dest)) loadDirectory(currentDir);
            else JOptionPane.showMessageDialog(this, "فشلت إعادة التسمية");
        }
    }

    private void createFolder() {
        String name = JOptionPane.showInputDialog(this, "اسم المجلد الجديد:");
        if (name != null && !name.trim().isEmpty()) {
            File f = new File(currentDir, name);
            if (f.mkdir()) loadDirectory(currentDir);
            else JOptionPane.showMessageDialog(this, "فشل إنشاء المجلد");
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            try {
                UIManager.setLookAndFeel(UIManager.getSystemLookAndFeelClassName());
            } catch (Exception ignored) {}
            new FileManager().setVisible(true);
        });
    }
}
